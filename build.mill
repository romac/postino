package build

import mill.*, scalalib.*
import mill.api.BuildCtx
import mill.scalalib.scalafmt.ScalafmtModule

object `package` extends ScalaModule with ScalafmtModule:
  outer =>

  override def scalaVersion = "3.8.3"

  override def scalacOptions = Seq(
    "-deprecation",
    "-feature",
    "-unchecked",
    "-new-syntax",
    "-Wunused:imports",
  )

  def fmt() = Task.Command:
    mill.scalalib.scalafmt.ScalafmtWorkerModule.worker().reformat(
      filesToFormat(sources()) ++
        filesToFormat(test.sources()) ++
        filesToFormat(postinoScodec.sources()) ++
        filesToFormat(postinoScodec.test.sources()),
      scalafmtConfig().head,
    )

  def interopTest() = Task.Command:
    val fixturePath = BuildCtx.workspaceRoot / "interop/fixtures/postcard-1.1.3.hex"
    println("Generating Rust postcard fixtures with Cargo...")

    val cargoResult =
      os.proc(
        "cargo",
        "run",
        "--quiet",
        "--manifest-path",
        "interop/rust-fixtures/Cargo.toml",
      ).call(
        cwd = BuildCtx.workspaceRoot,
        stdout = os.Pipe,
        stderr = os.Pipe,
        check = false,
      )

    if cargoResult.exitCode != 0 then
      Task.fail(
        s"Rust fixture generator failed with exit code ${cargoResult.exitCode}:\n${cargoResult.err.text()}"
      )

    val expected = canonicalFixture(os.read(fixturePath))
    val actual   = canonicalFixture(cargoResult.out.text())

    if actual != expected then
      os.write.over(Task.dest / "expected.hex", expected)
      os.write.over(Task.dest / "actual.hex", actual)
      Task.fail(
        s"Rust postcard fixtures differ. See ${Task.dest / "expected.hex"} and ${Task.dest / "actual.hex"}."
      )

    val fixtureCount = actual.linesIterator.count(_.nonEmpty)
    println(s"Compared $fixtureCount Rust postcard fixtures against $fixturePath")
    println("Rust postcard compatibility check passed.")

  private def canonicalFixture(text: String): String =
    text.replace("\r\n", "\n").stripTrailing + "\n"

  object test extends ScalaTests with TestModule.Munit:
    def rustFixtureResources = Task.Sources(BuildCtx.workspaceRoot / "interop/fixtures")

    override def resources = Task {
      super.resources() ++ rustFixtureResources()
    }

    override def mvnDeps = Seq(
      mvn"org.scalameta::munit:1.2.1",
    )

  object postinoScodec extends ScalaModule:
    override def scalaVersion = outer.scalaVersion()
    override def scalacOptions = outer.scalacOptions()
    override def sources = Task.Sources(BuildCtx.workspaceRoot / "postino-scodec/src")
    override def moduleDeps = Seq(outer)

    override def mvnDeps = Seq(
      mvn"org.scodec::scodec-core:2.3.3",
    )

    object test extends ScalaTests with TestModule.Munit:
      override def sources = Task.Sources(BuildCtx.workspaceRoot / "postino-scodec/test/src")

      override def mvnDeps = Seq(
        mvn"org.scalameta::munit:1.2.1",
      )
